{
  "$extensions": {
    "design-kit": {
      "name": "Example",
      "version": 1,
      "themes": [{ "id": "light", "name": "Light" }]
    }
  },
  "color": {
    "$type": "color",
    "$description": "One light theme. Text colours pass WCAG AA on surface and ground.",
    "ground": { "$value": "#F5F6F8", "$description": "The page behind cards." },
    "surface": { "$value": "#FFFFFF", "$description": "Cards, fields and menus." },
    "ink": { "$value": "#16181D", "$description": "Titles and body text." },
    "ink-2": { "$value": "#4B5260", "$description": "Secondary text: hints, meta, table cells." },
    "line": { "$value": "#DDE1E7", "$description": "Borders and dividers." },
    "accent": { "$value": "#3557D4", "$description": "The one action on a screen, links, the selected item." },
    "accent-hover": { "$value": "#2944AE", "$description": "An accent control under the pointer." },
    "on-accent": { "$value": "#FFFFFF", "$description": "Text on accent." },
    "positive": { "$value": "#1F7A4D", "$description": "Done, on time, passing." },
    "positive-soft": { "$value": "#E3F4EA", "$description": "A positive badge's fill." },
    "warning": { "$value": "#8A5A00", "$description": "Needs attention soon." },
    "warning-soft": { "$value": "#FDF1D8", "$description": "A warning badge's fill." },
    "neutral-soft": { "$value": "#EDEFF3", "$description": "A neutral badge's fill." },
    "focus": { "$value": "{color.accent}", "$description": "The keyboard focus ring: the accent, by alias." }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-card": {
      "$value": { "offsetX": "0", "offsetY": "1px", "blur": "2px", "spread": "0", "color": "rgba(22, 24, 29, 0.08)" },
      "$description": "A card resting on the ground."
    },
    "shadow-pop": {
      "$value": [
        { "offsetX": "0", "offsetY": "8px", "blur": "24px", "spread": "-4px", "color": "rgba(22, 24, 29, 0.18)" },
        { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "1px", "color": "{color.line}" }
      ],
      "$description": "Menus and popovers: a soft drop and a hairline."
    }
  },
  "spacing": {
    "$type": "dimension",
    "$description": "A 4px base.",
    "space-1": { "$value": "4px" },
    "space-2": { "$value": "8px" },
    "space-3": { "$value": "12px" },
    "space-4": { "$value": "16px" },
    "space-6": { "$value": "24px" }
  },
  "radius": {
    "$type": "dimension",
    "radius-sm": { "$value": "6px", "$description": "Badges and small controls." },
    "radius-md": { "$value": "10px", "$description": "Buttons and fields." },
    "radius-lg": { "$value": "14px", "$description": "Cards." }
  },
  "font": {
    "$type": "fontFamily",
    "font-sans": { "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"] },
    "font-mono": { "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
  },
  "typography": {
    "$type": "typography",
    "Text": {
      "text-title": {
        "$value": { "fontFamily": "{font.font-sans}", "fontSize": "22px", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "-0.01em" },
        "$description": "A screen's one title.",
        "$extensions": { "design-kit": { "sample": "Tasks" } }
      },
      "text-body": {
        "$value": { "fontFamily": "{font.font-sans}", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5 },
        "$description": "Everything else.",
        "$extensions": { "design-kit": { "sample": "Ship the onboarding checklist by Friday." } }
      },
      "text-code": {
        "$value": { "fontFamily": "{font.font-mono}", "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.4 },
        "$description": "Ids, counts and code.",
        "$extensions": { "design-kit": { "sample": "TASK-128" } }
      }
    }
  }
}
